<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>StoneshardCompanion.DocImages</AssemblyName><StartupObject>StoneshardCompanion.DocImages</StartupObject>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/Core/StoneshardCompanion.Core.csproj"/></ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Overlay/Usings.cs" Link="Usings.cs"/>
    <Compile Include="../../src/Overlay/HudWindow.cs" Link="HudWindow.cs"/>
    <Compile Include="../../src/Overlay/HudIcon.cs" Link="HudIcon.cs"/>
    <Compile Include="../../src/Overlay/SettingsWindow.cs" Link="SettingsWindow.cs"/>
    <Compile Include="../../src/Overlay/SaveWindow.cs" Link="SaveWindow.cs"/>
    <Compile Include="../../src/Overlay/UserPreferences.cs" Link="UserPreferences.cs"/>
    <Resource Include="../../src/Overlay/Assets/Icons/*.svg" Link="Assets/Icons/%(Filename)%(Extension)"/>
  </ItemGroup>
</Project>
