<Application x:Class="StoneshardCompanion.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#B8A5CC"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DFDCE6"/><Setter Property="Background" Value="#24232D"/><Setter Property="BorderBrush" Value="#625E72"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="350"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Edge" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="#101017" SnapsToDevicePixels="True">
     <Border x:Name="Face" BorderThickness="1,1,2,2" BorderBrush="#454350" Background="{TemplateBinding Background}" Margin="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#C4B4D3"/><Setter TargetName="Face" Property="Background" Value="#3C394A"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#17151F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#181720"/><Setter Property="Foreground" Value="#E1D5BC"/><Setter Property="BorderBrush" Value="#716780"/><Setter Property="Padding" Value="10"/></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#24232D"/><Setter Property="Foreground" Value="#E1D5BC"/><Setter Property="BorderBrush" Value="#716780"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Background" Value="#24232D"/><Setter Property="Foreground" Value="#E1D5BC"/></Style>
 </Application.Resources>
</Application>
